+/* P2D: bounded automatic SKIP on a real TCP retransmission timeout.
+ * A new RTO retries the same control range when its ACK was lost.
+ * Default: OFF. No attempt at general SACK/RACK/TLP suppression here.
+ */
+bool tcp_skipok_try_rto_skip(struct sock *sk)
+{
+	struct tcp_sock *tp = tcp_sk(sk);
+	struct sk_buff *skb;
+	u32 next_seq, end_seq, start_seq;
+
+	if (sk->sk_state != TCP_ESTABLISHED || !tp->skipok_negotiated ||
+	    !tp->skipok_auto_rto || tp->skipok_skip_pending ||
+	    !tcp_write_queue_empty(sk))
+		return false;
+
+	start_seq = tp->snd_una;
+	end_seq = tp->snd_nxt;
+	if (!after(end_seq, start_seq) ||
+	    (!tp->skipok_prefix_rto && end_seq - start_seq > 16384U))
+		return false;
+
+	next_seq = start_seq;
+	skb = tcp_rtx_queue_head(sk);
+	if (!skb)
+		return false;
+	while (skb) {
+		/* P2M: opt-in leading noncritical prefix only. Do not cross
+		 * a critical skb, a sequence discontinuity, or a partial skb.
+		 * The ordinary mode remains strict all-outstanding-noncritical.
+		 */
+		if (TCP_SKB_CB(skb)->seq != next_seq ||
+		    (TCP_SKB_CB(skb)->tcp_flags & (TCPHDR_SYN | TCPHDR_FIN)) ||
+		    !after(TCP_SKB_CB(skb)->end_seq, next_seq) ||
+		    after(TCP_SKB_CB(skb)->end_seq, end_seq))
+			return false;
+		if (TCP_SKB_CB(skb)->skipok_importance != 2) {
+			if (!tp->skipok_prefix_rto || next_seq == start_seq)
+				return false;
+			break;
+		}
+		if (TCP_SKB_CB(skb)->end_seq - start_seq > 16384U)
+			return false;
+		next_seq = TCP_SKB_CB(skb)->end_seq;
+		skb = skb_rb_next(skb);
+	}
+	if (!tp->skipok_prefix_rto && next_seq != end_seq)
+		return false;
+	if (next_seq == start_seq)
+		return false;
+	/* Only [snd_una, next_seq) is skipped; subsequent critical
+	 * bytes remain in retransmission queue for normal TCP recovery.
+	 */
+	end_seq = next_seq;
+	tp->skipok_skip_start = start_seq;
+	tp->skipok_skip_end = end_seq;
+	tp->skipok_skip_pending = 1;
+	tcp_send_ack(sk);
+	if (tp->skipok_skip_pending) {
+		/* No control was written; fall back to ordinary retransmit. */
+		tp->skipok_skip_pending = 0;
+		return false;
+	}
+	tp->skipok_rto_tx_count++;
+	return true;
+}
