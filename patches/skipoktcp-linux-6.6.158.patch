+/* P2C: lab-only, intentionally strict receiver-side hole advancement.
+ * Never skip bytes when the application still has earlier bytes to read.
+ * No control retransmission or durable gap-event queue yet (P2D/P2E).
+ */
+static void tcp_skipok_apply_skip(struct sock *sk, const struct sk_buff *skb)
+{
+	struct tcp_sock *tp = tcp_sk(sk);
+	const struct tcphdr *th = (const struct tcphdr *)skb->data;
+	const u8 *ptr = (const u8 *)(th + 1);
+	int remaining = (th->doff << 2) - sizeof(*th);
+
+	if (!tp->skipok_negotiated || !th->ack || th->syn || th->rst || th->fin ||
+	    skb->len != (th->doff << 2))
+		return;
+
+	while (remaining > 0) {
+		u8 kind = *ptr++;
+		u8 size;
+		u32 start, end;
+		struct sk_buff *first;
+
+		remaining--;
+		if (kind == TCPOPT_EOL)
+			return;
+		if (kind == TCPOPT_NOP)
+			continue;
+		if (remaining < 1)
+			return;
+		size = *ptr;
+		if (size < 2 || size - 1 > remaining)
+			return;
+		if (kind != TCPOPT_EXP || size != 16 ||
+		    get_unaligned_be32(ptr + 1) != 0x534b4f4bU ||
+		    ptr[5] != 1 || ptr[6] != 2)
+			goto next_option;
+
+		start = get_unaligned_be32(ptr + 7);
+		end = get_unaligned_be32(ptr + 11);
+		if (tp->skipok_skip_rx_count &&
+		    start == tp->skipok_skip_rx_start &&
+		    end == tp->skipok_skip_rx_end &&
+		    !after(end, tp->rcv_nxt)) {
+			tp->skipok_dup_rx_count++;
+			tcp_send_ack(sk);
+			return;
+		}
+		if (start != tp->rcv_nxt || !after(end, start) ||
+		    end - start > 16384U ||
+		    after(end, start + tcp_receive_window(tp)) ||
+		    READ_ONCE(tp->copied_seq) != start ||
+		    !skb_queue_empty(&sk->sk_receive_queue))
+			return;
+
+		first = skb_rb_first(&tp->out_of_order_queue);
+		if (first && before(TCP_SKB_CB(first)->seq, end))
+			return;
+
+		/* Since copied_seq == rcv_nxt and no earlier user bytes are
+		 * buffered, both pointers may advance without losing critical data.
+		 */
+		tcp_rcv_nxt_update(tp, end);
+		WRITE_ONCE(tp->copied_seq, end);
+		tp->skipok_skip_rx_count++;
+		tp->skipok_skip_rx_start = start;
+		tp->skipok_skip_rx_end = end;
+		if (first) {
+			tcp_ofo_queue(sk);
+			if (tp->rx_opt.num_sacks)
+				tcp_sack_remove(tp);
+			tcp_data_ready(sk);
+		}
+		/* Crucial: inform sender of the accepted SKIP via cumulative ACK. */
+		tcp_send_ack(sk);
+		return;
+next_option:
+		ptr += size - 1;
+		remaining -= size - 1;
+	}
+}
